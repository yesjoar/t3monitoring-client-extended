{
	"name": "yesjoar/t3monitoring-client-extended",
	"type": "typo3-cms-extension",
	"description": "Monitoring: scheduler and log insights - Adds scheduler, system log and log file insights to the t3monitoring_client endpoint",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"TYPO3",
		"monitoring",
		"t3monitoring",
		"scheduler",
		"sys_log"
	],
	"authors": [
		{
			"name": "Kai Seliger",
			"email": "kai@yesjoar.com",
			"homepage": "https://hikai.de",
			"role": "Developer"
		}
	],
	"require": {
		"php": "^8.2",
		"t3monitor/t3monitoring_client": "^11.0",
		"typo3/cms-core": "^12.4 || ^13.4 || ^14.0"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.64",
		"phpstan/phpstan": "^1.12 || ^2.0",
		"typo3/cms-scheduler": "^12.4 || ^13.4 || ^14.0",
		"typo3/coding-standards": "^0.8",
		"typo3/testing-framework": "^8.2 || ^9.0"
	},
	"suggest": {
		"typo3/cms-scheduler": "Required to report the scheduler state"
	},
	"autoload": {
		"psr-4": {
			"Yesjoar\\T3monitoringClientExtended\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Yesjoar\\T3monitoringClientExtended\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"extension-key": "t3monitoring_client_extended",
			"version": "0.2.0",
			"web-dir": ".Build/public"
		}
	},
	"scripts": {
		"cs": "php-cs-fixer fix --config Build/php-cs-fixer/config.php --dry-run --diff",
		"cs:fix": "php-cs-fixer fix --config Build/php-cs-fixer/config.php",
		"phpstan": "phpstan analyse --configuration Build/phpstan/phpstan.neon --no-progress",
		"test:unit": "phpunit --configuration Build/phpunit/UnitTests.xml",
		"test:functional": "phpunit --configuration Build/phpunit/FunctionalTests.xml",
		"test": [
			"@test:unit",
			"@test:functional"
		]
	}
}
